# Internal shared-secret login
OBSERVATORY_SHARED_SECRET=change-me
OBSERVATORY_COOKIE_SECRET=change-me-cookie-secret

# Supabase PostgreSQL connection for the private `noeud_forecast` schema.
# Use the TRANSACTION pooler URI from Supabase → Connect (IPv4-safe, port 6543),
# not the session pooler (5432): this app opens many short-lived queries from a
# serverless environment, and the session pooler's client cap is shared with the
# forecasting backend's own scheduled runs — it exhausts fast. Prefer the
# read-only login provisioned by `noeud-forecast provision-postgres-roles`:
#   postgresql://noeud_forecast_api.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
OBSERVATORY_DATABASE_URL=
OBSERVATORY_DB_SCHEMA=noeud_forecast
OBSERVATORY_DB_POOL_MAX=4

NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_FORECAST_TIMEZONE=Africa/Accra
